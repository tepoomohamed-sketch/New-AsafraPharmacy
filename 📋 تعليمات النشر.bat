@echo off
chcp 65001 > nul
title نسخ الملف للشبكة

echo.
echo  ╔══════════════════════════════════════════╗
echo  ║   نسخ ملف الصيدلية للمشاركة عبر الشبكة   ║
echo  ╚══════════════════════════════════════════╝
echo.

:: ── الحصول على IP ──
set "MY_IP="
for /f "tokens=2 delims=:" %%A in ('ipconfig ^| findstr /i "IPv4" ^| findstr "192.168"') do (
    if not defined MY_IP set "MY_IP=%%A"
)
if defined MY_IP set "MY_IP=%MY_IP:~1%"

echo  ✅ تم الإصلاح! الملف جاهز للاستخدام.
echo.
echo  ══════════════════════════════════════════
echo  الحل الأمثل: تشغيل السيرفر
echo  ══════════════════════════════════════════
echo.
echo  1. شغّل ملف: "شغّل السيرفر.bat"
echo.
if defined MY_IP (
    echo  2. على الجهاز الثاني افتح المتصفح واكتب:
    echo.
    echo         http://%MY_IP%:8080
    echo.
) else (
    echo  2. على الجهاز الثاني افتح المتصفح واكتب:
    echo     http://[IP-الجهاز-هذا]:8080
    echo.
)
echo  ══════════════════════════════════════════
echo  الحل البديل: نسخ الملف يدوياً
echo  ══════════════════════════════════════════
echo.
echo  انسخ هذا الملف للجهاز الثاني:
echo.
echo  "سجل الصيدلية - متعدد المستخدمين.html"
echo.
echo  من هذا المجلد:
echo  %~dp0
echo.
echo  ثم ضعه على Desktop الجهاز الثاني وافتحه
echo.
echo  ══════════════════════════════════════════
echo.
echo  ⚠️ تذكر: لا تنسى تحديث الصفحة على الجهاز الثاني
echo     (اضغط F5 أو Ctrl+Shift+R)
echo.
pause
